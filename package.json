{
  "name": "link-hub",
  "version": "0.24.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "prepare": "biome migrate --write",
    "build": "next build",
    "migrate": "prisma migrate deploy",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "biome check .",
