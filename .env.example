# Database
DATABASE_URL=
DIRECT_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/bookmarks

# ローカル開発用認証バイパス（任意、どちらか一方を設定）
# MOCK_USER_ID="<DB の users.id>"
# MOCK_USER_EMAIL="your@example.com"

# シード（prisma/seed.ts・ローカル専用）
#
# テストユーザー共通パスワード（シード実行時は必須）。
# シードは既存 Clerk ユーザーにもこの値を同期するため、プレースホルダのまま実行しないこと
# （Clerk アプリを共有する daily-hub / eval-hub のテストユーザーにも反映される）
# SEED_PASSWORD=<任意の強いパスワード>
#
# バイパスフラグ（SEED_ALLOW_DESTRUCTIVE / SEED_ALLOW_UNSEEDED_DB）は意図的に
# KEY=value 行として置かない。.env に書くと恒久的に有効になり「毎回明示的に意図を示す」
# というガードの前提が崩れるため、実行時にコマンドラインで前置する:
#   SEED_ALLOW_DESTRUCTIVE=1 npx tsx prisma/seed.ts
